generator client {
  provider = "prisma-client-js"
  output   = "./src/db"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_DB_URL")
}

model User {
  id         String   @id @default(uuid())
  name       String   @db.VarChar(100)
  email      String   @unique @db.VarChar(100)
  password   String
  created_at DateTime @default(now()) @db.Timestamp(6)

  // Messages
  senderMessages   Message[] @relation("UserMessages")
  receiverMessages Message[] @relation("DirectMessages")

  // Groups
  groups        Group[]       @relation("CreatedGroups")
  groupMembers  GroupMember[] @relation("GroupMembers")
}

model Group {
  id          String        @id @default(uuid())
  name        String
  createdBy   User?         @relation("CreatedGroups", fields: [createdById], references: [id])
  createdById String?
  members     GroupMember[] @relation("GroupMembers")
  messages    Message[]
  createdAt   DateTime      @default(now())
}

model GroupMember {
  id       String   @id @default(uuid())
  user     User     @relation("GroupMembers", fields: [userId], references: [id])
  userId   String
  group    Group    @relation("GroupMembers", fields: [groupId], references: [id])
  groupId  String
  joinedAt DateTime @default(now())

  @@unique([userId, groupId])
}

model Message {
  id         String   @id @default(uuid())
  content    String

  sender     User     @relation("UserMessages", fields: [senderId], references: [id])
  senderId   String

  // Optional: Either a group OR a direct message (not both)
  group      Group?   @relation(fields: [groupId], references: [id])
  groupId    String?

  receiver   User?    @relation("DirectMessages", fields: [receiverId], references: [id])
  receiverId String?

  createdAt  DateTime @default(now())
}
